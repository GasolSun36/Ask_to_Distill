# Cluster settings for launchers/slurm/*. Copy to launchers/slurm/cluster.env
# (gitignored) and fill in the placeholders. Nothing site-specific is committed.

# SLURM account and partitions.
ACCOUNT="<slurm-account>"
# Full 8-GPU nodes, multi-node allowed: synthesizer RL, OPD, tau2 jobs.
PARTITION_BIG="<partition-for-8-gpu-nodes>"
# 1-2 GPU jobs: calibration, sweep, pick, harvest shards, filter slices, merge, eval.
PARTITION_SMALL="<partition-for-small-gpu-jobs>"
# Wall clock per job. Long stages resume across jobs (see resubmit.sh).
TIME=4:00:00

# Environment activation inside the job.
CONDA_SH="<path/to/miniconda3>/etc/profile.d/conda.sh"
A2D_CONDA_ENV=a2d
# Optional: a file exporting A2D_DATA / A2D_MODELS / A2D_CKPT / A2D_OUT /
# A2D_CACHE / A2D_TAU2_PYTHON (usually configs/paths.env).
A2D_PATHS_ENV=

# Node shape. CPUS_PER_TASK is what each step asks for; Ray gets 4 fewer.
CPUS_PER_TASK=64
SMALL_CPUS_PER_TASK=16
SMALL_MEM=200G

# Optional: interleave host memory over all NUMA nodes for OPD processes
# (1 = on). Only needed where a job step is pinned to a subset of NUMA nodes and
# first-touch piles the offloaded weights onto them.
A2D_NUMA_INTERLEAVE=0

# Optional: extra sbatch arguments for every job (e.g. --qos=..., --exclude=...).
EXTRA_SBATCH_ARGS=

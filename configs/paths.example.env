# Copy to configs/paths.env (gitignored), edit, then `source configs/paths.env`.
# Every location defaults to a directory under the repository; relative values
# are resolved against the repository root, never the current directory.

# Released and built datasets (banks, prompts, calibration sets, eval data).
export A2D_DATA=${A2D_DATA:-}
# Downloaded base models (`a2d models download` writes here).
export A2D_MODELS=${A2D_MODELS:-}
# Training checkpoints and merged HF directories (hundreds of GB for fp32 OPD).
export A2D_CKPT=${A2D_CKPT:-}
# Stage outputs, run directories, eval results.
export A2D_OUT=${A2D_OUT:-}
# HF hub / triton / inductor / vLLM / evalplus caches (keep off a small HOME quota).
export A2D_CACHE=${A2D_CACHE:-}

# Interpreter of the separate tau2 env (printed by env/build_tau2_env.sh).
export A2D_TAU2_PYTHON=${A2D_TAU2_PYTHON:-}
# HF dataset repo that holds the release (`a2d data download`); set it to use a fork or mirror.
export A2D_HF_DATA_REPO=${A2D_HF_DATA_REPO:-gasolsun/Ask_to_Distill-data}
# Your own file with OPENAI_API_KEY=... for the tau2 eval user simulator.
# It is read at run time and never copied anywhere.
export A2D_OPENAI_ENV_FILE=${A2D_OPENAI_ENV_FILE:-}

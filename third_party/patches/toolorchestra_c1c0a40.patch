+def get_direct_openai_client():
+    """Plain OpenAI client for a key we hold directly, instead of NVIDIA's OAuth proxy.
+
+    get_azure_openai_client() needs CLIENT_ID/CLIENT_SECRET to mint a token
+    against prod.api.nvidia.com. With an ordinary OpenAI key there is nothing to
+    mint, so this builds the client from OPENAI_API_KEY/OPENAI_BASE_URL instead.
+
+    Accept-Encoding is pinned to gzip on purpose: this machine has brotli 1.0.9
+    while httpx calls Decompressor.process(..., output_buffer_limit=) which
+    landed in brotli 1.1, so every br-encoded response dies as
+    APIConnectionError: Connection error.
+    """
+    import pathlib
+    env_file = os.environ.get("TAU2_OPENAI_ENV")
+    if env_file and pathlib.Path(env_file).exists():
+        for line in pathlib.Path(env_file).read_text().splitlines():
+            line = line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            line = line[len("export "):] if line.startswith("export ") else line
+            k, _, v = line.partition("=")
+            os.environ[k.strip()] = v.strip().strip('"').strip("'")
+    return OpenAI(
+        api_key=os.environ["OPENAI_API_KEY"],
+        base_url=os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1"),
+        default_headers={"Accept-Encoding": "gzip"},
+        timeout=120,
+    )
+
+
 def get_llm_response(model, messages, temperature=1.0, return_raw_response=False, tools=None, show_messages=False, model_type=None, max_length=1024, model_config=None, model_config_idx=0, model_config_path=None, payload=None, openai_client_type='azure_openai', **kwargs):
     if isinstance(messages,str):
         messages = [{'role': 'user','content': messages}]
